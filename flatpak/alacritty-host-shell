#!/usr/bin/env python3
"""Run a login shell on the host, with a controlling terminal that works.

Background
----------
Overriding Alacritty's `terminal.shell` to `flatpak-spawn --host bash -l` puts
the shell on the host, but it silently breaks job control:

    bash: cannot set terminal process group (-1): Inappropriate ioctl for device
    bash: no job control in this shell

`TIOCSCTTY` is an exclusive, one-shot claim: the first session to grab a PTY
owns it, and no other session can ever take it. Alacritty does the textbook
thing — `setsid()` + `TIOCSCTTY` in its child, then `exec` — but under the
Flatpak that child is `flatpak-spawn`, a proxy that does nothing but forward a
D-Bus request. The proxy ends up owning the terminal. The real shell is spawned
separately by the Flatpak portal, in a different process tree, and by the time
it arrives the terminal is taken. It starts with no controlling terminal at all.

The fix is subtraction, not addition. The portal's own child setup makes the
host process a session leader and hands it the terminal *automatically* —
but only if the terminal is still free. So all that is needed is a PTY nobody
has claimed yet.

What this does
--------------
Sits between Alacritty and `flatpak-spawn` and opens a second PTY that it
deliberately never claims:

    alacritty ─(outer PTY, claimed by us — unavoidable)─ this relay
                                                           │
                                    (inner PTY, left unclaimed)
                                                           │
                             flatpak-spawn --host ──▶ portal ──▶ bash -l
                                                       claims the inner PTY
                                                       for the host shell ✓

Alacritty claims the outer PTY on *us*, which is fine and unavoidable. The
inner PTY is handed over untouched, so the host shell gets it and job control
works.

Two further details fall out of the sandwich:

* The outer terminal is put into raw mode, so control characters pass through
  as bytes instead of being interpreted twice. `Ctrl+C` and `Ctrl+Z` are
  handled by the *inner* line discipline, which is the one the host shell's
  jobs are attached to.
* `flatpak-spawn` forwards HUP/INT/QUIT/USR1/USR2/TERM/CONT/TSTP to the host
  process, but *not* `SIGWINCH` — so without this relay, resizing the window
  never reaches anything running in the shell. We are the foreground process
  group of the outer PTY, so we do receive `SIGWINCH`, and we copy the new
  size onto the inner PTY. Live resize works.

The environment needs the same kind of help. The portal starts host processes
from the *host session* environment rather than the sandbox's, which is correct
— it keeps the runtime's `LD_LIBRARY_PATH`, `XDG_CONFIG_HOME` and friends from
leaking into host programs. But it also drops `TERM` and `COLORTERM`, so the
shell comes up with no terminal type at all: no colour, and `clear`, `less`,
`tput` and every other ncurses program failing. Those are passed back
explicitly.

Usage:  alacritty-host-shell [command [args...]]
        with no arguments, runs the host's own login shell
"""

import errno
import fcntl
import os
import pty
import re
import select
import signal
import sys
import termios
import urllib.parse

BUFSIZE = 65536
OUTER = 0  # Alacritty's PTY, as stdin/stdout

# The terminal's own identity, which the portal would otherwise strip. Kept to a
# deliberate allowlist — the whole point of the portal's laundering is that the
# sandbox's environment must not become the host's.
FORWARD_ENV = ("TERM", "COLORTERM")

# Runs on the host, immediately before the shell. A TERM value only means
# anything if the host has a matching terminfo entry, and the host may never
# have heard of Alacritty — a Flatpak cannot install terminfo onto the host, so
# degrade to something universally present rather than break every ncurses
# program. (This is why Ptyxis announces xterm-256color: VTE's terminfo is
# always there.)
BOOTSTRAP = r"""
if ! command -v infocmp >/dev/null 2>&1 || ! infocmp "$TERM" >/dev/null 2>&1; then
    TERM=xterm-256color
fi
export TERM
if [ "$#" -gt 0 ]; then
    exec "$@"
fi
exec "${SHELL:-/bin/sh}" -l
"""


# "Open a new window here" needs the shell's working directory, and Alacritty
# finds it by reading /proc/<tcgetpgrp(pty)>/cwd. Across the sandbox boundary
# that fails twice over: the host shell lives in a different PID namespace and
# is not in /proc at all, and the foreground process group of Alacritty's PTY is
# *us*, not the shell. So Alacritty reads this relay's cwd — which makes the
# fix easy, because the shell is already announcing its directory in-band and we
# see every byte of it. Track the reports and chdir to match, and Alacritty's
# existing /proc lookup starts returning the right answer with no changes to it.
#
#   OSC 7     — the widely-implemented one, a file:// URI.
#   OSC 3008  — the shell-integration protocol Fedora's bash uses, which carries
#               cwd= among its fields. (OSC 7 is absent there because vte.sh
#               only arms itself for VTE terminals.)
CWD_REPORTS = (
    re.compile(rb"\x1b\]7;file://[^/\x07\x1b]*(/[^\x07\x1b]*)(?:\x07|\x1b\\)"),
    re.compile(rb"\x1b\]3008;[^\x07\x1b]*?;cwd=([^;\x07\x1b]*)(?:\x07|\x1b\\)"),
)
CWD_TAIL = 4096  # enough to rejoin a report split across two reads


def track_cwd(pending, chunk):
    """Follow the shell's directory reports. Returns the new pending tail."""
    buf = pending + chunk
    if b"\x1b]" not in buf:
        return b""

    newest, end = None, 0
    for pattern in CWD_REPORTS:
        for match in pattern.finditer(buf):
            newest, end = match.group(1), match.end()

    if newest is not None:
        path = urllib.parse.unquote_to_bytes(newest)
        try:
            os.chdir(os.fsdecode(path))
        except OSError:
            pass  # host-only path the sandbox can't see; keep the previous one
        return buf[end:][-CWD_TAIL:]

    return buf[-CWD_TAIL:]


def copy_winsize(src_fd, dst_fd):
    """Mirror the terminal window size from one PTY onto another."""
    try:
        packed = fcntl.ioctl(src_fd, termios.TIOCGWINSZ, b"\0" * 8)
        fcntl.ioctl(dst_fd, termios.TIOCSWINSZ, packed)
    except OSError:
        pass  # not a tty, or it went away; nothing useful to do either way


def set_raw(fd):
    """Put the outer terminal into raw mode, returning the old settings.

    The inner PTY keeps a normal line discipline, so it is the one that turns
    ^C into SIGINT for the host shell's foreground job. Interpreting control
    characters at both layers would deliver signals to this relay instead.
    """
    old = termios.tcgetattr(fd)
    new = termios.tcgetattr(fd)
    new[0] &= ~(termios.IGNBRK | termios.BRKINT | termios.PARMRK | termios.ISTRIP
                | termios.INLCR | termios.IGNCR | termios.ICRNL | termios.IXON)
    new[1] &= ~termios.OPOST
    new[2] &= ~(termios.CSIZE | termios.PARENB)
    new[2] |= termios.CS8
    new[3] &= ~(termios.ECHO | termios.ECHONL | termios.ICANON | termios.ISIG
                | termios.IEXTEN)
    new[6][termios.VMIN] = 1
    new[6][termios.VTIME] = 0
    termios.tcsetattr(fd, termios.TCSANOW, new)
    return old


def host_argv(command):
    """Build the flatpak-spawn invocation that starts the shell on the host."""
    argv = ["flatpak-spawn", "--host"]
    for name in FORWARD_ENV:
        value = os.environ.get(name)
        if value:
            argv.append(f"--env={name}={value}")
    return argv + ["sh", "-c", BOOTSTRAP, "sh", *command]


def main():
    command = sys.argv[1:]

    master, slave = pty.openpty()
    # Deliberately NO setsid() and NO TIOCSCTTY here. Leaving the inner PTY
    # unclaimed is the entire point: it lets the portal give it to the host
    # shell, which is the process that actually needs it.

    copy_winsize(OUTER, master)

    pid = os.fork()
    if pid == 0:
        os.close(master)
        for fd in (0, 1, 2):
            os.dup2(slave, fd)
        if slave > 2:
            os.close(slave)
        os.execvp("flatpak-spawn", host_argv(command))
        os._exit(127)

    os.close(slave)

    signal.signal(signal.SIGWINCH, lambda *_: copy_winsize(OUTER, master))

    try:
        old_termios = set_raw(OUTER)
    except termios.error:
        old_termios = None  # not a terminal (piped); relay bytes anyway

    try:
        _pump(master)
    finally:
        if old_termios is not None:
            try:
                termios.tcsetattr(OUTER, termios.TCSAFLUSH, old_termios)
            except termios.error:
                pass
        os.close(master)

    _, status = os.waitpid(pid, 0)
    if os.WIFEXITED(status):
        sys.exit(os.WEXITSTATUS(status))
    sys.exit(128 + os.WTERMSIG(status))


def _pump(master):
    """Copy bytes between the outer terminal and the inner PTY until EOF."""
    fds = [OUTER, master]
    pending = b""
    while True:
        try:
            readable, _, _ = select.select(fds, [], [])
        except InterruptedError:
            continue  # a SIGWINCH landed mid-select

        for fd in readable:
            try:
                data = os.read(fd, BUFSIZE)
            except OSError as exc:
                # The kernel reports a hung-up PTY master as EIO, not EOF.
                if exc.errno in (errno.EIO, errno.EBADF):
                    return
                raise
            if not data:
                return
            if fd == OUTER:
                _write_all(master, data)
            else:
                # Only the shell's own output can carry directory reports, and
                # bulk output has no escape sequences at all — so the common
                # case costs one substring check.
                if b"\x1b]" in data or pending:
                    pending = track_cwd(pending, data)
                _write_all(1, data)


def _write_all(fd, data):
    while data:
        try:
            data = data[os.write(fd, data):]
        except OSError as exc:
            if exc.errno in (errno.EIO, errno.EPIPE, errno.EBADF):
                return
            raise


if __name__ == "__main__":
    main()
