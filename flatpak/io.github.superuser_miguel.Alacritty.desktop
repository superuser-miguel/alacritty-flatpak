[Desktop Entry]
Type=Application
TryExec=alacritty
Exec=alacritty --config-file /app/share/alacritty/flatpak.toml
Icon=io.github.superuser_miguel.Alacritty
Terminal=false
Categories=System;TerminalEmulator;

Name=Alacritty
GenericName=Terminal
Comment=A fast, cross-platform, OpenGL terminal emulator (unofficial flatpak build)
StartupNotify=true
StartupWMClass=io.github.superuser_miguel.Alacritty
Actions=New;

[Desktop Action New]
Name=New Terminal
Exec=alacritty --config-file /app/share/alacritty/flatpak.toml
